# Copy this file to .env (which git ignores) and fill in your key:
#   cp .env.example .env
# Never commit .env or paste your key anywhere else.

# Your OpenAI API key (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Optional. Any chat model your account can use. Default: gpt-4o-mini
AI_MODEL=

# Optional. openai (default when a key is set) | mock (no key, no cost, for demos and tests) | none (AI off)
AI_PROVIDER=

# Optional. Any OpenAI-compatible endpoint. Default: https://api.openai.com/v1
AI_BASE_URL=

# Optional. Words the spelling check must never flag (brand, product or local names), comma-separated.
SITEFIX_ALLOW_WORDS=
